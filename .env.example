# Elegoo Connector environment template
# Copy this file to .env (local) or ~/.elegoo-bridge.env (on the Pi, chmod 600).

# Required: LAN IP of the Elegoo Centauri Carbon printer
EC_PRINTER_HOST=192.0.2.10

# Optional: cached mainboard ID (auto-discovered if omitted)
# EC_MAINBOARD_ID=

# Bridge HTTP server
EC_BIND=0.0.0.0
EC_PORT=8787

# Safety & authentication
EC_CONTROL=0
EC_AUTH_USER=operator
EC_AUTH_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
# Set to 1 only if a display directly on the Pi should bypass the login page
EC_TRUST_LOOPBACK=0

# Optional panel weather coordinates (defaults to KNMI De Bilt)
EC_PANEL_LAT=52.1000
EC_PANEL_LON=5.1800
# EC_PANEL_ROTATE=0

# Optional notifications, maintenance & metrics
# EC_NOTIFY_URL=https://ntfy.sh/REPLACE_WITH_A_LONG_RANDOM_TOPIC
# EC_NOTIFY_EVENTS=finished,failed
# EC_MAINTENANCE_HOURS=200
# EC_SNAPSHOT_CACHE_MS=800
# EC_METRICS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE
